FROM python:3.11-slim-bookworm

# --- Set working directory ---
WORKDIR /app

# --- Set env ---
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:${PATH}"

# --- Install System Dependencies ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    git \
    mecab \
    libmecab-dev \
    ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# --- Upgrade PIP ---
RUN python3.11 -m ensurepip --upgrade && \
    python3.11 -m pip install --no-cache-dir --upgrade pip

# --- Copy package files and install server dependencies ---
# CPU image is the Modal-offload deployment: no local Whisper, so no torch.
# Transcription is handled by Modal GPU containers; the LLM provider SDKs are
# included so breakdowns/explanations work without GPU.
COPY pyproject.toml README.md ./
COPY src/ src/
RUN python3.11 -m pip install --no-cache-dir ".[server,llm-openai,llm-anthropic]"

# --- Download UniDic Dictionary and Kotobase DB---
RUN python3.11 -m unidic download
RUN kotobase pull-db

# --- Expose the uvicorn port ---
EXPOSE 8000

# --- Start uvicorn with host mode ---
CMD ["python3.11", "-m", "uvicorn", "mirumoji.server.app:app", "--host", "0.0.0.0", "--port", "8000"]
