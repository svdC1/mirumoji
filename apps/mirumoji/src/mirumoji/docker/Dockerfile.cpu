# Published CPU image (Modal-Offload Deployment)
# Installs The Released Wheel From PyPI
# Built and pushed by CI

FROM python:3.11-slim-bookworm

# --- Working Directory ---
WORKDIR /app

# --- Environment ---
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:${PATH}"

# --- Released Version (CI Overrides Via --build-arg) ---
ARG MIRUMOJI_VERSION=3.0.0

# --- System Dependencies ---
# fugashi's wheel bundles libmecab, so no system mecab/libmecab-dev is needed
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# --- Upgrade PIP ---
RUN python3.11 -m ensurepip --upgrade && \
    python3.11 -m pip install --no-cache-dir --upgrade pip

# --- Install The Published Package ---
RUN python3.11 -m pip install --no-cache-dir \
    "mirumoji[server]==${MIRUMOJI_VERSION}"

# --- Download UniDic Dictionary + Kotobase DB ---
RUN python3.11 -m unidic download
RUN kotobase db pull

# --- Expose The Uvicorn Port ---
EXPOSE 8000

# --- Start Server ---
CMD ["python3.11", "-m", "uvicorn", "mirumoji.server.app:create_app", \
    "--factory", "--host", "0.0.0.0", "--port", "8000"]
