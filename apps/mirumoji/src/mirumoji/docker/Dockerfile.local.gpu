# Local-Build GPU Image
# Installs From Local Repo
# Used By `mirumoji build` / `mirumoji up --build`
# Build Context Is The Package Root (apps/mirumoji)

FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# --- Working Directory ---
WORKDIR /app

# --- Environment ---
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:${PATH}" \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# --- System Dependencies + Python Shim ---
# fugashi's wheel bundles libmecab, so no system mecab/libmecab-dev is needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    wget \
    xz-utils \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# --- Point 'python' + 'python3' At python3.11 ---
RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11  1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# --- Upgrade PIP ---
# CTranslate2 (faster-whisper's engine) uses the base image's CUDA 12 + cuDNN 9
# directly, so no PyTorch is installed
RUN python3.11 -m pip install --upgrade pip

# --- Install From The Working Tree + Local Whisper Extra ---
COPY pyproject.toml README.md ./
COPY src/ src/
RUN python3.11 -m pip install ".[server,whisper-local]"

# --- Download UniDic Dictionary + Kotobase DB ---
RUN python3.11 -m unidic download
RUN kotobase pull-db

# --- Model Is NOT Baked ---
# The faster-whisper model downloads on first use into the Hugging Face cache
# volume the launcher mounts for the local/GPU backend, keeping this image small

# --- Expose The Uvicorn Port ---
EXPOSE 8000

# --- Start Server  ---
CMD ["python3.11", "-m", "uvicorn", "mirumoji.server.app:create_app", \
    "--factory", "--host", "0.0.0.0", "--port", "8000"]
