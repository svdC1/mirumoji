# --- CUDA 12.3 + cuDNN 9 runtime ---
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# Set Workdir
WORKDIR /app

# Set environment Variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:${PATH}" \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# --- System deps & Python shim ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Ensure /usr/bin/python and /usr/bin/python3 both point to python3.11
RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11  1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# --- Install PyTorch (CUDA 12.4 wheels) ---
RUN python3.11 -m pip install --no-cache-dir --upgrade pip && \
    python3.11 -m pip install --no-cache-dir \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu124

# --- Install server + local-whisper ---
# Modal ships live source into container at run time
# (include_source=True), so the image only needs the runtime dependencies
COPY pyproject.toml README.md ./
COPY src/ src/
RUN python3.11 -m pip install --no-cache-dir ".[server,whisper-local]"

# --- Pre-cache the Faster-Whisper model ---
RUN python3.11 -c "from huggingface_hub import snapshot_download; \
    snapshot_download('Systran/faster-whisper-large-v3', local_dir_use_symlinks=False)"
