# Published GPU Image
# Installs The Released Wheel From PyPI
# Built And Pushed by CI

FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# --- Working Directory ---
WORKDIR /app

# --- Environment ---
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:${PATH}" \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# --- Released Version (CI Overrides Via --build-arg) ---
ARG MIRUMOJI_VERSION=3.0.0

# --- System Dependencies + Python Shim ---
# fugashi's wheel bundles libmecab, so no system mecab/libmecab-dev is needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    xz-utils \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# --- Static ffmpeg 7.x With NVENC / NVDEC + scale_cuda ---
# Ubuntu's apt ffmpeg (4.x) is built without the CUDA filters, so the on-device
# GPU conversion pipeline (scale_cuda) is impossible there. BtbN's GPL static
# build ships nvenc, nvdec, and scale_cuda (which needs only the CUDA driver at
# run time). Pinned to the 7.1 release line. For byte-reproducible builds, swap
# `latest` for a dated `autobuild-*` release tag
ARG FFMPEG_RELEASE=latest
ARG FFMPEG_BUILD=ffmpeg-n7.1-latest-linux64-gpl-7.1
RUN wget -O /tmp/ffmpeg.tar.xz \
    "https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_RELEASE}/${FFMPEG_BUILD}.tar.xz" \
    && tar -xf /tmp/ffmpeg.tar.xz -C /tmp \
    && mv /tmp/${FFMPEG_BUILD}/bin/ffmpeg /tmp/${FFMPEG_BUILD}/bin/ffprobe /usr/local/bin/ \
    && rm -rf /tmp/ffmpeg.tar.xz /tmp/${FFMPEG_BUILD} \
    && ffmpeg -version

# --- Point 'python' + 'python3' At python3.11 ---
RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11  1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# --- Upgrade PIP ---
# CTranslate2 (faster-whisper's engine) uses the base image's CUDA 12 + cuDNN 9
# directly, so no PyTorch is installed
RUN python3.11 -m pip install --upgrade pip

# --- Install The Published Package + Local Whisper Extra ---
RUN python3.11 -m pip install \
    "mirumoji[server,whisper-local]==${MIRUMOJI_VERSION}"

# --- Download UniDic Dictionary + Kotobase DB ---
RUN python3.11 -m unidic download
RUN kotobase pull-db

# --- Model Is NOT Baked ---
# The faster-whisper model downloads on first use into the Hugging Face cache
# volume the launcher mounts for the local/GPU backend, keeping this image small

# --- Expose The Uvicorn Port ---
EXPOSE 8000

# --- Start Server ---
CMD ["python3.11", "-m", "uvicorn", "mirumoji.server.app:create_app", \
    "--factory", "--host", "0.0.0.0", "--port", "8000"]
