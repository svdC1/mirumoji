{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": ["./src/"],
    "entryPointStrategy": "expand",
    "out": "../../docs/site/docs_md/Frontend-UI",
    "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-mdn-links", "typedoc-plugin-rename-defaults", "typedoc-plugin-extras", "typedoc-plugin-no-inherit"],
    "readme": "none",
    "theme": "markdown",
    "router": "module",
    "hidePageTitle": true,
    "hidePageHeader":true,
    "hideBreadcrumbs":true,
    "useCodeBlocks":true,
    "indexFormat": "table",
    "parametersFormat": "table",
    "interfacePropertiesFormat": "table",
    "classPropertiesFormat": "table",
    "typeAliasPropertiesFormat": "table",
    "enumMembersFormat": "table",
    "propertyMembersFormat": "table",
    "typeDeclarationFormat": "table",
    "tableColumnSettings": {
        "hideDefaults": false,
        "hideInherited": true,
        "hideModifiers": false,
        "hideOverrides": true,
        "hideSources": false,
        "hideValues": false,
        "leftAlignHeaders": false
    },
    "formatWithPrettier": true,
    "inheritNone": true,
    "tsconfig": "./tsconfig.json"
}
