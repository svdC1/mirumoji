{
    "name": "Mirumoji (CPU)",
    "image": "docker.io/svdC1/mirumoji_dev:cpu-latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "KevinRose.vsc-python-indent",
                "bradlc.vscode-tailwindcss",
                "esbenp.prettier-vscode",
                "christian-kohler.path-intellisense",
                "ms-python.flake8"
            ]
        }
    },
    "forwardPorts": [8000, 5173]
}
