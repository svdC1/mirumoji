{
    "name": "Mirumoji (CPU)",
    "image": "docker.io/svdc1/mirumoji_dev:cpu-latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "KevinRose.vsc-python-indent",
                "charliermarsh.ruff",
                "bradlc.vscode-tailwindcss",
                "esbenp.prettier-vscode",
                "christian-kohler.path-intellisense"
            ]
        }
    },
    "forwardPorts": [8000, 5173],
    "postCreateCommand": "pip install -e './apps/mirumoji[server,dev,gui]' && (cd apps/frontend && npm install) && pip install pre-commit && pre-commit install"
}
