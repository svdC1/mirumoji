# --- Start From NVIDIA Image ---
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# --- Set WORKDIR and Variables ---
WORKDIR /workspace

ENV PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:${PATH}" \
    PIP_NO_CACHE_DIR=1\
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    NODE_VERSION=24.16.0


# --- System Packages ---

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    xz-utils \
    software-properties-common \
    curl \
    gnupg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- Static ffmpeg 7.x With NVENC / NVDEC + scale_cuda ---
# Ubuntu's apt ffmpeg (4.x) is built without the CUDA filters, so the on-device
# GPU conversion pipeline (scale_cuda) is impossible there. BtbN's GPL static
# build ships nvenc, nvdec, and scale_cuda (which needs only the CUDA driver at
# run time). Matches the published GPU image so dev parity holds
ARG FFMPEG_RELEASE=latest
ARG FFMPEG_BUILD=ffmpeg-n7.1-latest-linux64-gpl-7.1
RUN wget -O /tmp/ffmpeg.tar.xz \
    "https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_RELEASE}/${FFMPEG_BUILD}.tar.xz" \
    && tar -xf /tmp/ffmpeg.tar.xz -C /tmp \
    && mv /tmp/${FFMPEG_BUILD}/bin/ffmpeg /tmp/${FFMPEG_BUILD}/bin/ffprobe /usr/local/bin/ \
    && rm -rf /tmp/ffmpeg.tar.xz /tmp/${FFMPEG_BUILD} \
    && ffmpeg -version

# --- Install Python 3.11 ---
RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3.11-venv python3-pip \
    && rm -rf /var/lib/apt/lists/* && \
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    python3.11 -m pip install --upgrade pip

# --- Install Node 24 ---

RUN ARCH= && dpkgArch="$(dpkg --print-architecture)" \
    && case "${dpkgArch##*-}" in \
    amd64) ARCH='x64';; \
    ppc64el) ARCH='ppc64le';; \
    s390x) ARCH='s390x';; \
    arm64) ARCH='arm64';; \
    armhf) ARCH='armv7l';; \
    i386) ARCH='x86';; \
    *) echo "unsupported architecture"; exit 1 ;; \
    esac \
    && curl -fsSLO --compressed "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$ARCH.tar.xz" \
    && tar -xJf "node-v$NODE_VERSION-linux-$ARCH.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
    && rm "node-v$NODE_VERSION-linux-$ARCH.tar.xz" \
    && ln -s /usr/local/bin/node /usr/local/bin/nodejs \
    # Smoke Test Node
    && node --version \
    && npm --version

# --- Japanese Dictionary Data ---
# The full app deps are installed editable at container-create time (see the
# .devcontainer postCreateCommand). Only the packages needed to fetch the
# dictionary data are installed here, so the data is baked into the image and
# the first container open stays fast
RUN python3.11 -m pip install "fugashi[unidic]" kotobase
RUN python3.11 -m unidic download && \
    kotobase pull-db

# --- Expose Vite Dev Port + Uvicorn Port ---
EXPOSE 8000
EXPOSE 5173

# --- Drop Into bash ---
CMD ["bash"]
